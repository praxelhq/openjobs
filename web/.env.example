# A separate first-party consumer key (key_kind=consumer, account_id=praxy-web,
# channel=candidate-search). Keep it server-only; do not use a paid service key.
OPENJOBS_CONSUMER_SEARCH_KEY=
# Shared Redis for all web instances. Never use per-process rate limits in production.
OPENJOBS_REDIS_URL=
# Off until production key, Redis, domain, and a real search smoke test pass.
OPENJOBS_PUBLIC_LAUNCH_ENABLED=0
# Set only after the public hostname is verified. Staging and unset values remain noindex.
PUBLIC_SITE_URL=
# Shared cap on upstream requests per minute. Keep 60 until traffic and capacity justify more.
OPENJOBS_GLOBAL_LIMIT_PER_MINUTE=60
# Shared upstream cache misses per UTC day; clamped to 1..20000.
OPENJOBS_GLOBAL_LIMIT_PER_DAY=5000
PORT=3000
